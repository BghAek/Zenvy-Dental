# Copy to .env (gitignored) before running the stack: cp .env.example .env
# Later sprints add their own keys here (OpenAI S2, Meta/WhatsApp S0-9, Stripe S3).

# API
PORT=3001

# Postgres — Neon dev branch (used from S0-4 / Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Redis — docker compose service (used from S0-5 / BullMQ).
# Inside docker the api container is given redis://redis:6379 automatically.
REDIS_URL=redis://localhost:6379
