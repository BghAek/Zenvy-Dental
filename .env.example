# Copy to .env (gitignored) before running the stack: cp .env.example .env
# Later sprints add their own keys here (OpenAI S2, Meta/WhatsApp S0-9, Stripe S3).

# API
PORT=3001

# Postgres — Neon dev branch (used from S0-4 / Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth (S0-5) — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# Public origin of the API (cookie security derives from the protocol).
BETTER_AUTH_URL=http://localhost:3001
# Public origin of the web dashboard (S1-2) — staff-invite links point here as
# {APP_WEB_URL}/register?invite=<token>. Defaults to the production app origin.
APP_WEB_URL=http://localhost:5173

# CORS allowlist (S2-7) — comma-separated exact origins, empty by default.
# Production serves the SPAs and /api from the same nginx origin, so leave it
# unset there; set it for a split-origin local run (VITE_API_URL) or an api.
# subdomain, e.g. CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# CORS_ORIGINS=

# Redis — docker compose service (used from S0-5 / BullMQ).
# Inside docker the api container is given redis://redis:6379 automatically.
REDIS_URL=redis://localhost:6379

# OpenAI (S2-3) — the AI conversation engine. Without a key the engine stays
# silent: inbound messages are still stored, no reply is generated.
# platform.openai.com → API keys.
OPENAI_API_KEY=CHANGE_ME
# Optional override; defaults to gpt-4o-mini (docs/05-ai-policy.md).
# OPENAI_MODEL=gpt-4o-mini

# Meta / WhatsApp webhook (S0-9) — full walkthrough in docs/api/meta-setup.md.
# Self-chosen secret string; must match the "Verify token" entered in the Meta
# webhook configuration. Generate with: openssl rand -hex 16
META_VERIFY_TOKEN=CHANGE_ME
# Meta App Dashboard → App settings → Basic → App secret (signs webhook payloads).
META_APP_SECRET=CHANGE_ME
# WhatsApp → API Setup → WhatsApp Business Account ID. Only the template
# registration script needs it (S3-1, docs/api/whatsapp-templates.md).
META_WABA_ID=CHANGE_ME
# Graph API token for outbound sends (S2-2) — WhatsApp → API Setup → temporary
# access token (24h) while the app is in dev mode.
META_ACCESS_TOKEN=CHANGE_ME
